  CUSTOMER_TECHNICAL_CONTACT varchar(50)
  TER_SALES_ACCOUNT_OWNER varchar(50)
  DIS_PROJECT_LEAD_ID nvarchar [not null,note: 'Regional Design Lead']
  DIS_DESIGN_LEAD_ID nvarchar [note: 'GDC Manager']
  DIS_OPERATIONS_OWNER_ID nvarchar [note: 'Planner']
  DIS_REGIONAL_MANAGER_ID nvarchar [not null,note: 'Sales']
  DIS_APPS_SUPPORT_NAME varchar(50)
  DIS_APPS_SUPPORT_EMAIL varchar(50)
  DIS_APPS_SUPPORT_LOCATION_ID nvarchar
  KEY_SOCKET varchar(3)
  DIS_MASTER_KEY varchar(20)
