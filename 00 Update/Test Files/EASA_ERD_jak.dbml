  DESIGN_CAPACITY_RESERVED nvarchar
  PRIORITY_LEVEL nvarchar
  DESING_APPROVAL_ACTUAL_DATE datetime2
  DESING_MLO_GERBER_OUT_DATE datetime2
  DIS_PROJECT_MANAGER nvarchar [note: 'Customer Care']
  PCB_TER_PN varchar(50)
  MLO_TER_PN varchar(50)
  SHARED_ID varchar(20)
  ASSY_FINISH_DATE datetime2
  DIB_DIAG_DATE datetime2
  ACTIVE nvarchar [not null]
  DIS_REPEAT_COORDINATOR_ID nvarchar [note: 'Repeat Coordinator']
  DIS_TECHNICAL_SALES nvarchar [note: 'Technical Sales']
  ACTUAL_GERBER_OUT_DATE datetime2
  ACTUAL_MLO_GERBER_OUT_DATE datetime2
  DIS_DESIGN_MANAGER nvarchar  [note: 'Design Manager']
}

Table OPP_MG_CUSTOMER_PROJECTS {
