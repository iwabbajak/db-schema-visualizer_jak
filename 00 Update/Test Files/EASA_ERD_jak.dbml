Table ACCOUNTS {
  ACCOUNT_ID nvarchar [pk, not null]
  ACCOUNT_NM varchar(150)
  ACCOUNT_DS varchar(250)
  ACTIVE varchar(1)
  CREATE_USER_ID varchar(50)
  CREATE_TS nvarchar
  UPDATE_USER_ID varchar(50)
  UPDATE_TS nvarchar
  ACCT_ROLE_ID varchar(3)
  ACCT_SALES_ID nvarchar
  PROG_MNGR_ID nvarchar
  CUSTOMER_CONTACT varchar(200)
  SHIP_TO_ADDRESS varchar(200)
  CUSTOMER_ADDRESS varchar(200)
  ORACLE_ID varchar(20)
  IS_PROSPECT varchar(5)
  SERVICENOW_ID varchar(20)
  MASTER_CUSTOMER_SYSID varchar(100)
}

Table OPP_MG_CUSTOMER_OPPORTUNITIES {
