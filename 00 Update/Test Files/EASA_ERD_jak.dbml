}

Table QUOTES_OUTPUT_CASE_DATA {
  CASE_DATA_ID nvarchar [not null]
  CASE_ID nvarchar [not null]
  VERSION_ID nvarchar
  REFERENCE_NM varchar(250)
  CONTENT_TX varchar(4000)
  CREATE_USER_ID varchar(50)
  CREATE_TS nvarchar
  UPDATE_USER_ID varchar(50)
  UPDATE_TS nvarchar
}


Table STATUS {
  STATUS_ID nvarchar [pk, not null]
  SEQ_NO nvarchar
  STATUS_DS varchar(50) [not null]
  APPROVAL_ID nvarchar
  CREATE_USER_ID varchar(50)
  CREATE_TS datetime2
  UPDATE_USER_ID varchar(50)
  UPDATE_TS datetime2
}
Table CUSTOMER_CATEGORY {
  CUSTOMER_CATEGORY_ID decimal(38,10) [pk, not null]
  CUSTOMER_CATEGORY_NM varchar(15) [not null,note: 'TOFU orNON-TOFU']
  CUSTOMER_CATEGORY_DESCRIPTION varchar(50)
  CREATE_USER_ID varchar(50)
  CREATE_TS datetime2
  UPDATE_USER_ID varchar(50)
  UPDATE_TS datetime2
}

Table OPP_MG_INDUSTRIES {
  INDUSTRY_ID int
  INDUSTRY_NM varchar(100) [not null]
  CREATE_USER_ID varchar(50)
  CREATE_TS datetime2
  UPDATE_USER_ID varchar(50)
  UPDATE_TS datetime2
}

Table OPP_MG_INDUSTRIES_SEGMENT {
  SEGMENT_ID nvarchar [not null]
  SEGMENT_NAME varchar(50) [not null]
  INDUSTRY_ID nvarchar [not null]
  CREATE_USER_ID varchar(50)
  CREATE_TS nvarchar
  UPDATE_USER_ID varchar(50)
  UPDATE_TS nvarchar
}

Table USER_ROLE {
  USER_ROLE_ID nvarchar [pk, not null]
  USER_ID nvarchar
  ROLE_ID nvarchar
  CREATE_USER_ID varchar(50)
  CREATE_TS datetime2
  UPDATE_USER_ID varchar(50)
  UPDATE_TS datetime2
}


Table USERS {
  USER_ID int [pk, not null]
  FIRST_NM varchar(25)
  LAST_NM varchar(25)
  ROLE_ID nvarchar
  LOGIN_ID varchar(50)
  REGION_ID nvarchar [not null]
  ACTIVE_IN char(1)
  CREATE_USER_ID varchar(50)
  CREATE_TS datetime2
  UPDATE_USER_ID varchar(50)
  UPDATE_TS datetime2
  ACCOUNT_ID nvarchar
  WORKGROUP_ID nvarchar
  EMAIL varchar(60)
}

Table ROLE {
  ROLE_ID nvarchar [pk, not null]
  ROLE_NM varchar(50)
  ROLE_DS varchar(250)
  CREATE_PROJ_FL nvarchar
  EDIT_PROJECT_FL nvarchar
  EDIT_ASSIGNMENTS_FL nvarchar
  COMPLETE_TASKS_FL nvarchar
  CREATE_USER_ID varchar(50)
  CREATE_TS datetime2
  UPDATE_USER_ID varchar(50)
  UPDATE_TS datetime2
  REVIEW_DESIGN_FL nvarchar
  PROJ_ACCESS_FL nvarchar
}

Table QUOTES_TASKS {
  TASK_ID nvarchar [not null]
  TASK_LU_ID nvarchar [not null]
  STATUS_ID nvarchar [not null]
  ASSIGNED_USER_ID nvarchar
  START_DATE nvarchar
  END_DATE nvarchar
  APPROVAL1 nvarchar [not null]
  APPROVAL2 nvarchar [not null]
  CREATE_USER_ID varchar(50)
  CREATE_TS datetime2
  UPDATE_USER_ID varchar(50)
  UPDATE_TS datetime2
  TOOL_TASK_ID nvarchar
  QUOTE_ID nvarchar
  IS_ESCALATED nvarchar [not null]
}


Table PROJECT_TYPE {
  PROJECT_TYPE_ID nvarchar [pk]
  PROJECT_TYPE_NM varchar(25)
  PROJECT_TYPE_DS varchar(250)
  CREATE_USER_ID varchar(50)
  CREATE_TS datetime2
  UPDATE_USER_IS varchar(50)
  UPDATE_TS datetime2
  TOOL_ID nvarchar
}

Ref: OPP_MG_CUSTOMER_PROJECTS.ACCOUNT_ID > ACCOUNTS.ACCOUNT_ID
Ref: OPP_MG_CUSTOMER_PROJECTS.CUSTOMER_CATEGORY_ID > CUSTOMER_CATEGORY.CUSTOMER_CATEGORY_ID
Ref: QUOTES.ACCOUNT_ID > ACCOUNTS.ACCOUNT_ID
Ref: QUOTES_CASES.ACCOUNT_ID > ACCOUNTS.ACCOUNT_ID
Ref: USER_ROLE.USER_ID > USERS.USER_ID
Ref: USER_ROLE.ROLE_ID > ROLE.ROLE_ID
Ref: OPP_MG_CUSTOMER_OPPORTUNITIES.CUSTOMER_PROJECT_ID > OPP_MG_CUSTOMER_PROJECTS.CUSTOMER_ID
Ref: OPP_MG_NPI_REPEAT.OPPORTUNITY_ID > OPP_MG_CUSTOMER_OPPORTUNITIES.OPPORTUNITY_ID
Ref: OPP_MG_NPI_REPEAT.QUOTE_ID > QUOTES.QUOTE_ID
Ref: OPP_MG_INDUSTRIES.INDUSTRY_ID > OPP_MG_CUSTOMER_PROJECTS.INDUSTRY_ID
Ref: OPP_MG_INDUSTRIES_SEGMENT.SEGMENT_ID > OPP_MG_CUSTOMER_PROJECTS.SEGMENT_ID
Ref: QUOTES.QUOTE_ID > QUOTES_CASES.QUOTE_ID
Ref: QUOTES_CASES.CASE_ID > QUOTES_CASE_DATA.CASE_ID
Ref: QUOTES_CASES.CASE_ID > QUOTES_OUTPUT_CASE_DATA.CASE_DATA_ID
Ref: QUOTES_TASKS.QUOTE_ID > QUOTES.QUOTE_ID
Ref: QUOTES_TASKS.STATUS_ID > STATUS.STATUS_ID
Ref: OPP_MG_NPI_REPEAT.PROJECT_TYPE_ID > PROJECT_TYPE.PROJECT_TYPE_ID